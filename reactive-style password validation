#include <stdio.h>
#include <string.h>

int main() {
    char password[100];

    // list of banned passwords
    char banned[][20] = {
        "123456789",
        "password",
        "admin@123",
        "123456",
        "qwerty"
    };

    int bannedCount = 5;
    int isBanned = 0;

    printf("Enter password: ");
    scanf("%s", password);

    // check banned passwords
    for(int i = 0; i < bannedCount; i++) {
        if(strcmp(password, banned[i]) == 0) {
            isBanned = 1;
            break;
        }
    }

    if(isBanned) {
        printf("❌ Weak Password (Banned)\n");
    } else {
        printf("✅ Password Accepted\n");
    }

    return 0;
}
