#include<stdio.h>
#include <string.h>
#include <ctype.h>

int main(){
	int upper=0, lower=0, special=0, digits=0;
	int i, length;
	char password[100];
	
	printf("Enter the Password : ");
	scanf("%s",password);
	length = strlen(password);
	printf("\nLength of password is %d ",strlen(password));
	for(i=0;i<length;i++){
		if(isupper(password[i])){
			upper = 1;
		}else if(islower(password[i])){
			lower = 1;
		}else if(isdigit(password[i])){
			digits = 1;
		}else{
			special = 1;
		}
	}
	
	if(length >=8 && upper && lower && special && digits){
		printf("\nStrong password");
	}else if(length >=6 && (special && lower) || (upper && digits)){
		printf("\nMedium password");
	}else{
		printf("\nWeak password");
	}
	return 0;
}
