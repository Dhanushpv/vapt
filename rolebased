#include <stdio.h>
#include <string.h>

int main() {
    char username[20], password[20];

    printf("Enter username: ");
    scanf("%s", username);

    printf("Enter password: ");
    scanf("%s", password);

    // Admin
    if (strcmp(username, "admin") == 0 && strcmp(password, "123") == 0) {
        printf("\nLogin Successful");
        printf("\nRole: Admin");
        printf("\nFull Access Granted");
    }
    // User
    else if (strcmp(username, "user") == 0 && strcmp(password, "123") == 0) {
        printf("\nLogin Successful");
        printf("\nRole: User");
        printf("\nRead & Write Access");
    }
    // Guest
    else if (strcmp(username, "guest") == 0 && strcmp(password, "123") == 0) {
        printf("\nLogin Successful");
        printf("\nRole: Guest");
        printf("\nRead Only Access");
    }
    // Invalid
    else {
        printf("\nLogin Failed");
    }

    return 0;
}
